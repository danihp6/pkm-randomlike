# Copy to $HOME/pkm-agent/env (chmod 600) and fill every empty value.
# It is sourced by bash, so `$HOME` is allowed.

# The model the whole cycle runs on.
PKM_MODEL=opencode-go/deepseek-v4.1-flash

# The inference key. Same value as the OPENCODE_API_KEY repository secret.
OPENCODE_API_KEY=

# A PAT with `contents: write` and `issues: write` on the repository (classic `repo`
# scope, or fine-grained with Contents + Issues). This is what pushes `main`.
GH_TOKEN=

# The private asset store (same values as the repository's ASSETS_REPO/ASSETS_COMMIT).
ASSETS_REPO=danihp6/pkrl-assets
ASSETS_COMMIT=
ASSETS_STORE=$HOME/pkm-assets/store
ASSETS_DEPLOY_KEY_FILE=$HOME/.ssh/pkm-assets

# Paths, only if you moved them.
PKM_REPO=$HOME/pkm-randomlike
PKM_AGENT_STATE=$HOME/pkm-agent

# 0 or empty means no cap: the backlog's own finiteness is the only bound.
AGENT_DAILY_CYCLES=0
