# Copy to .env and fill in. `.env` is gitignored — never commit the token.
#
# Cloudflare API token with permission to edit DNS records in the zone below
# (Zone → DNS → Edit). https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Optional overrides (defaults shown)
# CLOUDFLARE_ZONE_NAME=herreteam.com
# SITE_DOMAIN=pokerandomlike.herreteam.com
# CLOUDFLARE_PROXIED=false
