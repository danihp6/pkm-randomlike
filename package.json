{
  "name": "poke-randomlike",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "data:dex": "node scripts/build-dex.mjs",
    "data:anil": "node scripts/anil/build-pokemon-sprites.mjs",
    "data:anil:items": "node scripts/anil/build-item-icons.mjs",
    "data:frlg:icons": "node scripts/frlg/build-type-icons.mjs && node scripts/frlg/build-status-icons.mjs",
    "data:ui": "node scripts/ui/build-chrome.mjs",
    "docs:coverage": "node scripts/effect-coverage.mjs",
    "infra:install": "npm --prefix infra install",
    "infra:synth": "npm --prefix infra run synth",
    "infra:deploy": "npm run build && npm --prefix infra run deploy"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@pkmn/dex": "^0.10.11",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
