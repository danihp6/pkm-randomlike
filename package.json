{
  "name": "poke-randomlike",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "data:dex": "node scripts/build-dex.mjs",
    "data:anil": "node scripts/anil/build-pokemon-sprites.mjs",
    "docs:coverage": "node scripts/effect-coverage.mjs",
    "infra:install": "npm --prefix infra install",
    "infra:synth": "npm --prefix infra run synth",
    "infra:deploy": "npm run build && npm --prefix infra run deploy"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@pkmn/dex": "^0.10.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.17.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
