{
  "name": "poke-randomlike",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "assets:pack": "node scripts/assets/pack.mjs",
    "assets:placeholders": "node scripts/assets/build-placeholders.mjs",
    "data:dex": "node scripts/build-dex.mjs",
    "data:anil": "node scripts/anil/build-pokemon-sprites.mjs",
    "data:anil:items": "node scripts/anil/build-item-icons.mjs",
    "data:frlg:icons": "node scripts/frlg/build-type-icons.mjs && node scripts/frlg/build-status-icons.mjs",
    "data:ui": "node scripts/ui/build-chrome.mjs",
    "docs:coverage": "node scripts/effect-coverage.mjs",
    "infra:install": "npm --prefix infra install",
    "infra:synth": "npm --prefix infra run synth",
    "infra:deploy": "npm run build && npm --prefix infra run deploy",
    "design:export": "node scripts/design/export.mjs",
    "design:tokens": "node scripts/design/tokens.mjs",
    "hud:diff": "node scripts/hud/diff.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "phaser": "^3.90.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@pkmn/dex": "^0.10.11",
    "@types/node": "^22.20.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
